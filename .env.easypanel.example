# ---------------------------------------------------------------------------
# Bindarr — variables para EasyPanel (App con Dockerfile)
#
# EasyPanel no lee este archivo: es una plantilla. Si creas el servicio como
# "App" con origen GitHub/Dockerfile (en vez de Compose), copia estas claves en
# la pestaña "Environment" del panel. Para el modo Compose ya están dentro de
# docker-compose.easypanel.yml.
# ---------------------------------------------------------------------------

# Puerto interno del contenedor. En EasyPanel, el dominio debe apuntar al 3001.
PORT=3001

# Vacío = solo HTTP. El Traefik de EasyPanel termina el TLS con certificado real
# y la cámara funciona igual por https://<dominio>. Déjalo vacío salvo que
# quieras además el HTTPS autofirmado propio de la app (puerto 3443).
HTTPS_PORT=

# Rutas internas persistentes (no las cambies salvo caso especial).
DB_PATH=/app/database/bindarr.db
CV_MODEL_DIR=/app/database/models

# Un salto de proxy: el Traefik de EasyPanel. Imprescindible para que los
# limitadores de peticiones vean la IP real y no saturen el login compartido.
TRUST_PROXY=1

# URL pública del servicio, p. ej. https://cartas.tudominio.com . Recomendada:
# da forma a los enlaces compartidos y se añade sola como origen CORS permitido.
PUBLIC_BASE_URL=

# Orígenes CORS extra, separados por comas. Opcional.
CORS_ORIGIN=

# Opcional: contraseña del usuario `admin` creada en el primer arranque. Si la
# dejas vacía, la primera visita al navegador te pedirá crear la cuenta dueño.
DEFAULT_ADMIN_PASSWORD=

# Opcional: "true" permite registro público de nuevos usuarios.
ALLOW_REGISTRATION=
